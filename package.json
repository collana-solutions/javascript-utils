{
  "name": "@collana-solutions/javascript-utils",
  "version": "2.6.0",
  "description": "This is a collection of utilities that we have created to help with our development process.",
  "homepage": "https://github.com/collana-solutions/javascript-utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/collana-solutions/javascript-utils"
  },
  "license": "MIT",
  "author": "collana solutions AG",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/index.modern.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.ts",
  "jsnext:main": "dist/index.modern.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c --configPlugin rollup-plugin-typescript2",
    "lint": "eslint --cache",
    "prepack": "pnpm run build",
    "prepare-pr": "pnpm exec prettier . --write && pnpm run lint && pnpm run build && pnpm run test",
    "prettier-check": "prettier --check .",
    "prettier-write": "prettier --write .",
    "start": "rollup -c -w",
    "test": "cross-env TZ=Europe/Zurich jest",
    "start-all": "concurrently \"pnpm run start\" \"pnpm run start-yalc\"",
    "start-yalc": "nodemon --watch dist -x \"yalc push\"",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@jest/types": "^30.5.1",
    "@neolution-ch/eslint-config-neolution": "^3.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/rollup-plugin-peer-deps-external": "^2.2.5",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "jest": "^30.5.2",
    "jest-localstorage-mock": "^2.4.26",
    "jiti": "^2.4.2",
    "nodemon": "^3.1.14",
    "pkg-pr-new": "^0.0.93",
    "prettier": "^3.5.3",
    "rollup": "^4.68.0",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-typescript2": "^0.37.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "yalc": "^1.0.0-pre.53"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "packageManager": "pnpm@11.22.0"
}
